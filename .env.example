# Copy to .env and adjust. Both values are required; there are no defaults.
# The .env file is gitignored.

# The application role: a non-superuser that owns nothing. Created by
# db/bootstrap.sql (make db-bootstrap).
DATABASE_URL=postgres://godough_app:snippet_app@127.0.0.1:5432/snippet?sslmode=disable

# The owner, for migrations only. `make db-migrate` reads this one.
DATABASE_URL_OWNER=postgres://godough:snippet@127.0.0.1:5432/snippet?sslmode=disable

# Host and port the HTTP server listens on.
SNIPPET_ADDR=:4000
