# Copy to .env and adjust. The runtime values are required; the test values are
# required by make db-test and make test. There are no defaults. The .env file
# is gitignored.

# The application role: a non-superuser that owns nothing. Created by
# db/bootstrap.sql (make db-bootstrap).
DATABASE_URL=postgres://godough_app:snippet_app@127.0.0.1:5432/snippet?sslmode=disable

# The owner, for migrations only. `make db-migrate` reads this one.
DATABASE_URL_OWNER=postgres://godough:snippet@127.0.0.1:5432/snippet?sslmode=disable

# The test database. `make db-test` creates, bootstraps and migrates it;
# `make test` reads TEST_DATABASE_URL and refuses to run without it. It is a
# separate database so a test run cannot write to the development database.
TEST_DATABASE_URL=postgres://godough_app:snippet_app@127.0.0.1:5432/snippet_test?sslmode=disable
TEST_DATABASE_URL_OWNER=postgres://godough:snippet@127.0.0.1:5432/snippet_test?sslmode=disable

# Host and port the HTTP server listens on.
SNIPPET_ADDR=:4000

# Development logging. Compose does not pass these to the api service, so
# containers keep the code defaults: JSON at info. A host process gets text and
# debug from here.
LOG_LEVEL=debug
LOG_FORMAT=text

# Origins allowed to make cookie-authenticated writes. Comma-separated, exact
# scheme and host. An empty list fails closed: every write is 403.
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
