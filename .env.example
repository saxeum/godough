# Copy to .env and adjust. Both values are required; there are no defaults.
# The .env file is gitignored.

# godough_app, created by docker-entrypoint-initdb.d/01-app-role.sql.
# Migrations run as godough instead (make db-migrate, which connects over the
# container's trusted unix socket).
DATABASE_URL=postgres://godough_app:snippet_app@127.0.0.1:5432/snippet?sslmode=disable

# Host and port the HTTP server listens on.
SNIPPET_ADDR=:4000
